# Mobile/backend URLs and public config - no secrets. See mobile/src/config.js
# for the actual fallback values baked into the app, and mobile/.env for the
# checked-in real values already in use.

# AWS backend: React Native -> API Gateway -> JWT authorizer -> Lambda -> DynamoDB.
EXPO_PUBLIC_AWS_API_URL=https://l4irn73k01.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_AWS_REGION=us-east-1

# Cognito (public mobile client - NO client secret, by design).
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_oH6wx6AFd
EXPO_PUBLIC_COGNITO_CLIENT_ID=6gp7272venghtl4o74ksqb7lr1

# Local Python therapist/risk engine (FastAPI on your Mac) - a SEPARATE
# backend from AWS, reachable only on your LAN. Set this to your Mac's LAN IP.
EXPO_PUBLIC_THERAPIST_ENGINE_URL=http://192.168.2.126:8000

# Local risk_engine FastAPI service (risk_engine/api.py), if run standalone.
EXPO_PUBLIC_RISK_ENGINE_URL=http://127.0.0.1:8001

# therapist_engine/api/main.py's own optional DynamoDB/Rekognition path
# (separate from the mobile app's AWS calls above). Leave false unless you
# are specifically testing that local service against real AWS resources.
USE_AWS=false
AWS_REGION=us-east-1
# Never place AWS secret keys (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) here
# or anywhere in the mobile app. The Lambda execution role supplies AWS
# credentials automatically; the phone only ever holds Cognito JWTs.
