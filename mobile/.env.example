# Public client identifiers (NOT secrets). Expo inlines EXPO_PUBLIC_* at build time.
# Never add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / KMS material here.
EXPO_PUBLIC_AWS_REGION=YOUR_VALUE_HERE
EXPO_PUBLIC_AWS_API_URL=https://l4irn73k01.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_COGNITO_USER_POOL_ID=YOUR_VALUE_HERE
EXPO_PUBLIC_COGNITO_CLIENT_ID=YOUR_VALUE_HERE
# EXPO_PUBLIC_THERAPIST_ENGINE_URL is intentionally UNSET.
# src/config.js derives the engine host from Metro automatically, so it
# follows the Mac onto whatever network it is on. Only set this if the
# engine runs somewhere OTHER than the machine serving the JS bundle.
# EXPO_PUBLIC_THERAPIST_ENGINE_URL=YOUR_VALUE_HERE
